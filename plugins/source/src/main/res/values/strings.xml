    <!-- Libre / FSL special settings -->
    <string name="libre_special_settings">Libre Special Settings</string>
    <string name="fsl_apply_smoothing_title">Enable Libre calibration + smoothing</string>
    <string name="fsl_apply_smoothing_summary">Apply offset/slope calibration and exponential smoothing to all readings from this source (required for Juggluco and any source that already sends a raw value)</string>
    <string name="fsl_use_ukf_smoothing_title">Use UKF instead of exponential smoothing</string>
    <string name="fsl_use_ukf_smoothing_summary">Only applies when Libre calibration + smoothing is on. Replaces the exponential (single-pole) smoother above with an incremental Unscented Kalman Filter over the same calibrated raw stream. Changes the actual BG value dosing sees.</string>
    <string name="fsl_cal_offset_title">Calibration offset</string>
    <string name="fsl_cal_offset_summary">OFFSET in: calibrated = OFFSET + slope × raw</string>
    <string name="fsl_cal_slope_title">Calibration slope</string>
    <string name="fsl_cal_slope_summary">SLOPE in: calibrated = offset + SLOPE × raw</string>
    <string name="fsl_smooth_alpha_title">Smoothing factor (alpha)</string>
    <string name="fsl_smooth_alpha_summary">1st-order exponential smoothing. 1.0 = no smoothing, 0.1 = max smoothing</string>
    <string name="fsl_calibration_trigger_title">Start sensor calibration</string>
    <string name="fsl_calibration_trigger_summary">Enables calibration mode — SMBs are paused during warm-up</string>
    <string name="fsl_calibration_end_title">Ignore remaining calibration time</string>
    <string name="fsl_calibration_end_summary">Skip the rest of the calibration warm-up period</string>
    <string name="old_sensor_adj_enabled_title">Aging-sensor calibration adjustment</string>
    <string name="old_sensor_adj_enabled_summary">Off = stay at the slope/offset above as usual. On = override them with a tiered adjustment on days 12-15 of the sensor\'s life (while MJ hypo-warning state is active), reverting automatically outside that window</string>
    <string name="fsl_max_smooth_gap_title">Max gap to smooth (min)</string>
    <string name="fsl_max_smooth_gap_summary">Gaps longer than this skip smoothing and use the raw value directly</string>

