<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="com.dexcom.cgm.EXTERNAL_PERMISSION" />
    <!-- Trial (2026-11-24, from AIMI): Dexcom ONE+ / G7 native driver -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- The Dexcom ONE+ / G7 start screen reads the applicator barcode. Typing the code still works without it. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- The CGM apps of the catalog (cgm_apps.json) must be visible to be found and opened (Android 11+). The
         catalog updates without a release, so naming the packages here could never keep up: every app with a
         launcher icon is visible instead. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <activity
            android:name=".activities.RequestDexcomPermissionActivity"
            android:exported="false" />

        <!-- Trial (2026-11-24, from AIMI): Dexcom ONE+ / G7 screens and the driver log -->
        <activity
            android:name=".activities.DexcomOnePlusStatusActivity"
            android:exported="false" />
        <activity
            android:name=".activities.DexcomOnePlusStartActivity"
            android:exported="false" />
        <activity
            android:name=".activities.DexcomOnePlusWarmupActivity"
            android:exported="false" />
        <activity
            android:name=".activities.CgmDriverLogActivity"
            android:exported="false" />

        <service
            android:name=".notificationreader.NotificationCollectorService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Trial (from AIMI): keeps the ONE+ / G7 Bluetooth session alive with the screen off. The type is what grants
             the privilege on Android 14+. -->
        <service
            android:name=".DexcomOnePlusSessionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
