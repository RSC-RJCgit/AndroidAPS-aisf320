<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/graphs_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.jjoe64.graphview.GraphView
            android:id="@+id/bg_graph"
            android:layout_width="wrap_content"
            android:layout_height="200dp"
            android:contentDescription="@string/a11y_graph" />

        <Button
            android:id="@+id/scale_button"
            android:layout_width="65dp"
            android:layout_height="35dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="35dp"
            android:contentDescription="@string/a11y_graph_scale"
            android:drawableEnd="@drawable/ic_arrow_drop_down_white_24dp"
            android:padding="0dp"
            android:textAllCaps="false" />

        <!-- The current BG, fixed under the hours drop-down so it stays in place while the graph scrolls (2026-10-27).
             Filled by OverviewFragment.updateBg; hidden while an older window is shown. -->
        <TextView
            android:id="@+id/graph_bg_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/scale_button"
            android:layout_alignStart="@id/scale_button"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/history_previous"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:contentDescription="@string/history_previous_window"
            android:padding="0dp"
            android:text="‹"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/history_date"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/history_next"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_alignParentTop="true"
            android:layout_toEndOf="@id/scale_button"
            android:contentDescription="@string/history_current_window"
            android:padding="0dp"
            android:text="›"
            android:textSize="24sp" />

        <ImageButton
            android:id="@+id/chart_menu_button"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="5dp"
            android:contentDescription="@string/chart_menu"
            android:paddingTop="5dp"
            app:srcCompat="@drawable/ic_arrow_drop_down_white_24dp" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/secondary_graphs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- 5th graph: fixed clone of bg_graph above (minus basal), gated by BooleanKey.ApsAutoIsfShowGraph5.
         Visibility is toggled at runtime in OverviewFragment.updateGraph(); gone by default. -->
    <RelativeLayout
        android:id="@+id/graph5_container"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <com.jjoe64.graphview.GraphView
            android:id="@+id/graph5"
            android:layout_width="wrap_content"
            android:layout_height="200dp"
            android:contentDescription="@string/a11y_graph" />

        <!-- Legend for the four top-band lines (SMBdel, aISFwt, ppISFwt, profBasal), each name in its line colour.
             Text and colours are set in OverviewFragment.updateGraph(); empty (and so invisible) when no line has data. -->
        <TextView
            android:id="@+id/graph5_legend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="44dp"
            android:layout_marginTop="2dp"
            android:textSize="10sp"
            android:textStyle="bold" />

    </RelativeLayout>

</LinearLayout>
