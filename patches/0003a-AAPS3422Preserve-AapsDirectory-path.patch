From b0d4310008fd95069155ccec92576ed78220d1ce Mon Sep 17 00:00:00 2001
From: RSC-RJCgit <142757046+RSC-RJCgit@users.noreply.github.com>
Date: Wed, 20 May 2026 10:53:24 +0930
Subject: [PATCH] Preserve AAPS directory path across settings import

Save and restore AapsDirectoryUri around sp.clear() during import so
the local device path is never wiped or overwritten by an imported
settings file from a different phone.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 .../configuration/maintenance/ImportExportPrefsImpl.kt | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/plugins/configuration/src/main/kotlin/app/aaps/plugins/configuration/maintenance/ImportExportPrefsImpl.kt b/plugins/configuration/src/main/kotlin/app/aaps/plugins/configuration/maintenance/ImportExportPrefsImpl.kt
index e7679177f6..9c19f01c31 100644
--- a/plugins/configuration/src/main/kotlin/app/aaps/plugins/configuration/maintenance/ImportExportPrefsImpl.kt
+++ b/plugins/configuration/src/main/kotlin/app/aaps/plugins/configuration/maintenance/ImportExportPrefsImpl.kt
@@ -874,6 +874,8 @@ class ImportExportPrefsImpl @Inject constructor(
                     PrefImportSummaryDialog.showSummary(activity, importOk, importPossible, prefs, {
                         if (importPossible) {
                             activePlugin.beforeImport()
+                            // Preserve device-specific path — never let an import overwrite it
+                            val savedAapsDirectory = sp.getString(StringKey.AapsDirectoryUri.key, null)
                             sp.clear()
                             for ((key, value) in prefs.values) {
                                 if (value == "true" || value == "false") {
@@ -882,10 +884,14 @@ class ImportExportPrefsImpl @Inject constructor(
                                     sp.putString(key, value)
                                 }
                             }
-                            
+                            // Restore local AAPS directory path so it is never lost on import
+                            if (!savedAapsDirectory.isNullOrEmpty()) {
+                                sp.putString(StringKey.AapsDirectoryUri.key, savedAapsDirectory)
+                            }
+
                             // All settings including Google Drive settings and export destination preferences
                             // are now imported from backup file. If tokens are invalid, user can re-authorize.
-                            
+
                             activePlugin.afterImport()
                             restartAppAfterImport(activity)
                         } else {
-- 
