@@ -0,0 +1,80 @@
+package app.aaps.plugins.automation.triggers
+
+import androidx.compose.material.icons.Icons
+import androidx.compose.material.icons.filled.Flag
+import app.aaps.core.interfaces.logging.LTag
+import app.aaps.core.interfaces.navigation.ElementType
+import app.aaps.core.keys.interfaces.TextRef
+import app.aaps.core.utils.lenientStringOrNull
+import app.aaps.plugins.automation.AutomationStates
+import app.aaps.plugins.automation.AutomationStrings
+import app.aaps.plugins.automation.elements.Comparator
+import app.aaps.plugins.automation.elements.InputString
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+
+/**
+ * True when an automation state holds [value] ("is equal"), or holds no value at all ("is not available"). The comparator
+ * has no "is not equal": for "Sport is not On", test the other value ("Sport is equal Off"). The other comparisons compare
+ * the text alphabetically. A state that holds no value matches nothing but "is not available".
+ */
+class TriggerAutomationState(deps: TriggerDeps) : Trigger(deps) {
+
+    var name = InputString()
+    var value = InputString()
+    var comparator = Comparator(rh, Comparator.Compare.IS_EQUAL)
+
+    private val states get() = AutomationStates(preferences)
+
+    constructor(deps: TriggerDeps, triggerAutomationState: TriggerAutomationState) : this(deps) {
+        name = InputString(triggerAutomationState.name.value)
+        value = InputString(triggerAutomationState.value.value)
+        comparator = Comparator(rh, triggerAutomationState.comparator.value)
+    }
+
+    fun setState(name: String, value: String): TriggerAutomationState {
+        this.name.value = name
+        this.value.value = value
+        return this
+    }
+
+    fun comparator(comparator: Comparator.Compare): TriggerAutomationState {
+        this.comparator.value = comparator
+        return this
+    }
+
+    override suspend fun shouldRun(): Boolean {
+        val current = states.current(name.value)
+        val ready =
+            if (comparator.value == Comparator.Compare.IS_NOT_AVAILABLE) current.isEmpty()
+            else current.isNotEmpty() && comparator.value.check(current, value.value.trim())
+        aapsLogger.debug(LTag.AUTOMATION, (if (ready) "Ready for execution: " else "NOT ready for execution: ") + friendlyDescription())
+        return ready
+    }
+
+    override fun dataJSON(): JsonObject =
+        buildJsonObject {
+            put("name", name.value)
+            put("value", value.value)
+            put("comparator", comparator.value.toString())
+        }
+
+    override fun fromJSON(data: String): Trigger {
+        val d = jsonOf(data)
+        name.value = d.lenientStringOrNull("name").orEmpty()
+        value.value = d.lenientStringOrNull("value").orEmpty()
+        comparator.value = d.lenientStringOrNull("comparator")?.let { Comparator.Compare.valueOf(it) } ?: Comparator.Compare.IS_EQUAL
+        return this
+    }
+
+    override fun friendlyName(): TextRef = AutomationStrings.automation_state_trigger
+
+    override fun friendlyDescription(): String =
+        rh.gs(AutomationStrings.automation_state_compared, name.value, rh.gs(comparator.value.stringRes), value.value)
+
+    override fun composeIcon() = Icons.Filled.Flag
+    override fun elementType() = ElementType.AUTOMATION
+
+    override fun duplicate(): Trigger = TriggerAutomationState(deps, this)
+}
