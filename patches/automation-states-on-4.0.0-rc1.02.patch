+import app.aaps.plugins.automation.AutomationStates
+import app.aaps.plugins.automation.AutomationStrings
+import app.aaps.plugins.automation.elements.InputString
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+
+/**
+ * Gives an automation state a value. A state or value that is not declared yet is declared by this, so the rule works at
+ * once; the "State" trigger and the Automation states dialog then see it.
+ */
+class ActionSetAutomationState(
+    aapsLogger: AAPSLogger,
+    rh: TextResolver,
+    pumpEnactResultProvider: () -> PumpEnactResult,
+    private val states: AutomationStates
+) : Action(aapsLogger, rh, pumpEnactResultProvider) {
+
+    var name = InputString()
+    var value = InputString()
+
+    override fun friendlyName(): TextRef = AutomationStrings.set_automation_state
+    override fun shortDescription(): String = rh.gs(AutomationStrings.set_automation_state_description, name.value, value.value)
+    override fun composeIcon() = Icons.Filled.Flag
+    override fun elementType() = ElementType.AUTOMATION
+
+    override suspend fun doAction(): PumpEnactResult {
+        states.setFromRule(name.value, value.value)
+        return pumpEnactResultProvider().success(true).comment(CoreUiStrings.ok)
+    }
+
+    override fun toJSON(): String =
+        buildJsonObject {
+            put("type", this@ActionSetAutomationState::class.simpleName)
+            put("data", buildJsonObject {
+                put("name", name.value)
+                put("value", value.value)
+            })
+        }.toString()
+
+    override fun fromJSON(data: String): Action {
+        val o = jsonOf(data)
+        name.value = o.lenientString("name", "")
+        value.value = o.lenientString("value", "")
+        return this
+    }
+
+    override fun hasDialog(): Boolean = true
+
+    override fun isValid(): Boolean = name.value.isNotBlank() && value.value.isNotBlank()
+}
