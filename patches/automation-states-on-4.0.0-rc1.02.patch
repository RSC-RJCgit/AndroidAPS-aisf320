@@ -0,0 +1,58 @@
+package app.aaps.plugins.automation.triggers
+
+import app.aaps.core.keys.StringNonKey
+import app.aaps.plugins.automation.AutomationStrings
+import app.aaps.plugins.automation.asJsonObject
+import app.aaps.plugins.automation.elements.Comparator
+import com.google.common.truth.Truth.assertThat
+import kotlinx.coroutines.test.runTest
+import org.junit.jupiter.api.Test
+import org.mockito.kotlin.whenever
+import org.skyscreamer.jsonassert.JSONAssert
+
+class TriggerAutomationStateTest : TriggerTestBase() {
+
+    private fun holds(current: String) {
+        whenever(preferences.get(StringNonKey.AutomationCurrentStates)).thenReturn(current)
+        whenever(preferences.get(StringNonKey.AutomationStateValues)).thenReturn("""{"Sport":["On","Off"]}""")
+    }
+
+    private fun trigger(compare: Comparator.Compare) = TriggerAutomationState(triggerDeps).setState("Sport", "On").comparator(compare)
+
+    @Test fun isEqualRunsOnlyOnTheSameValue() = runTest {
+        holds("""{"Sport":"On"}""")
+        assertThat(trigger(Comparator.Compare.IS_EQUAL).shouldRun()).isTrue()
+        holds("""{"Sport":"Off"}""")
+        assertThat(trigger(Comparator.Compare.IS_EQUAL).shouldRun()).isFalse()
+    }
+
+    /** A state with no value is "not available", and matches nothing else */
+    @Test fun aStateWithNoValueIsNotAvailable() = runTest {
+        holds("{}")
+        assertThat(trigger(Comparator.Compare.IS_NOT_AVAILABLE).shouldRun()).isTrue()
+        assertThat(trigger(Comparator.Compare.IS_EQUAL).shouldRun()).isFalse()
+    }
+
+    private val json = """{"data":{"name":"Sport","value":"On","comparator":"IS_EQUAL"},"type":"TriggerAutomationState"}"""
+
+    @Test fun toJSONTest() {
+        JSONAssert.assertEquals(json, trigger(Comparator.Compare.IS_EQUAL).toJSON(), true)
+    }
+
+    @Test fun fromJSONTest() {
+        val t = triggerFactory.instantiate(trigger(Comparator.Compare.IS_NOT_AVAILABLE).toJSON().asJsonObject()) as TriggerAutomationState
+        assertThat(t.name.value).isEqualTo("Sport")
+        assertThat(t.value.value).isEqualTo("On")
+        assertThat(t.comparator.value).isEqualTo(Comparator.Compare.IS_NOT_AVAILABLE)
+    }
+
+    @Test fun copyKeepsTheValues() {
+        val t = trigger(Comparator.Compare.IS_NOT_AVAILABLE).duplicate() as TriggerAutomationState
+        assertThat(t.name.value).isEqualTo("Sport")
+        assertThat(t.comparator.value).isEqualTo(Comparator.Compare.IS_NOT_AVAILABLE)
+    }
+
+    @Test fun friendlyNameTest() {
+        assertThat(TriggerAutomationState(triggerDeps).friendlyName()).isEqualTo(AutomationStrings.automation_state_trigger)
+    }
+}
