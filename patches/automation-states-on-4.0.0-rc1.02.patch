+package app.aaps.ui.compose.overview
+
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.ExperimentalLayoutApi
+import androidx.compose.foundation.layout.FlowRow
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.material.icons.Icons
+import androidx.compose.material.icons.filled.Flag
+import androidx.compose.material3.AssistChip
+import androidx.compose.material3.Icon
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.produceState
+import androidx.compose.ui.Modifier
+import app.aaps.core.interfaces.navigation.ElementType
+import app.aaps.core.keys.StringNonKey
+import app.aaps.core.ui.compose.AapsSpacing
+import app.aaps.core.ui.compose.LocalPreferences
+import app.aaps.core.ui.compose.navigation.NavigationRequest
+import app.aaps.core.ui.compose.stringResource
+import app.aaps.ui.UiStrings
+import kotlinx.coroutines.delay
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+
+/** How often the chips read the states again while the overview is open */
+private const val STATES_REFRESH_MS = 30_000L
+
+/**
+ * One chip for each automation state that holds a value, as "name: value". A tap opens the Automation states dialog.
+ * Nothing is shown while no state holds a value.
+ *
+ * Read again every 30 seconds, and when the overview opens again, so a change made by a rule or in the dialog shows.
+ */
+@OptIn(ExperimentalLayoutApi::class)
+@Composable
+fun AutomationStatesChips(onNavigate: (NavigationRequest) -> Unit, modifier: Modifier = Modifier) {
+    val preferences = LocalPreferences.current
+    val states by produceState(initialValue = emptyList<Pair<String, String>>(), preferences) {
+        while (true) {
+            value = automationStatesWithValue(preferences.get(StringNonKey.AutomationCurrentStates))
+            delay(STATES_REFRESH_MS)
+        }
+    }
+    if (states.isEmpty()) return
+    FlowRow(modifier = modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(AapsSpacing.small)) {
+        for ((name, value) in states) {
+            AssistChip(
+                onClick = { onNavigate(NavigationRequest.Element(ElementType.AUTOMATION_STATES)) },
+                label = { Text(stringResource(UiStrings.overview_automation_state, name, value)) },
+                leadingIcon = { Icon(Icons.Filled.Flag, contentDescription = null) }
+            )
+        }
+    }
+}
+
+/** The states that hold a value, in name order. Broken saved text gives none. */
+internal fun automationStatesWithValue(currentJson: String): List<Pair<String, String>> {
+    val json = runCatching { Json.parseToJsonElement(currentJson) as? JsonObject }.getOrNull() ?: return emptyList()
+    return json.mapNotNull { (name, value) ->
+        (value as? JsonPrimitive)?.takeIf { it.isString }?.content?.takeIf { it.isNotEmpty() }?.let { name to it }
+    }.sortedBy { it.first }
+}
