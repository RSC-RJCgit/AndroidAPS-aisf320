@@ -0,0 +1,62 @@
+package app.aaps.plugins.automation
+
+import app.aaps.core.keys.interfaces.Preferences
+import app.aaps.core.keys.interfaces.StringNonPreferenceKey
+import org.mockito.kotlin.any
+import org.mockito.kotlin.doAnswer
+import org.mockito.kotlin.mock
+import org.mockito.kotlin.whenever
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+
+/** The store as the action, the trigger and the dialog use it, over settings kept in a map */
+class AutomationStatesTest {
+
+    private val saved = mutableMapOf<String, String>()
+    private val preferences = mock<Preferences>().also { prefs ->
+        whenever(prefs.get(any<StringNonPreferenceKey>())).thenAnswer { saved[(it.arguments[0] as StringNonPreferenceKey).key] ?: "{}" }
+        doAnswer { saved[(it.arguments[0] as StringNonPreferenceKey).key] = it.arguments[1] as String }
+            .whenever(prefs).put(any<StringNonPreferenceKey>(), any<String>())
+    }
+    private val states = AutomationStates(preferences)
+
+    /** A rule must work without the state being set up in the dialog first */
+    @Test
+    fun aRuleDeclaresANewStateAndValue() {
+        states.setFromRule(" Sport ", " On ")
+
+        assertEquals(listOf(AutomationStateEntry("Sport", "On", listOf("On"))), states.entries())
+        assertEquals("On", states.current("Sport"))
+    }
+
+    @Test
+    fun aRuleAddsANewValueToAKnownState() {
+        states.setValues("Sport", listOf("On", "Off"))
+        states.setFromRule("Sport", "Paused")
+
+        assertEquals(listOf("On", "Off", "Paused"), states.entries().single().values)
+        assertEquals("Paused", states.current("Sport"))
+    }
+
+    @Test
+    fun anEmptyNameOrValueChangesNothing() {
+        states.setFromRule("Sport", " ")
+        states.setFromRule("", "On")
+
+        assertEquals(emptyList(), states.entries())
+    }
+
+    @Test
+    fun theDialogCanOnlyPickADeclaredValue() {
+        states.setValues("Sport", listOf("On", "Off"))
+
+        assertFalse(states.setCurrent("Sport", "Maybe"))
+        assertEquals("", states.current("Sport"))
+    }
+
+    @Test
+    fun anUnknownStateHoldsNoValue() {
+        assertEquals("", states.current("Nothing"))
+    }
+}
