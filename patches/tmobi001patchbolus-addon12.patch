diff --git a/core/objects/src/commonMain/kotlin/app/aaps/core/objects/wizard/FollowUpInsulinCap.kt b/core/objects/src/commonMain/kotlin/app/aaps/core/objects/wizard/FollowUpInsulinCap.kt
