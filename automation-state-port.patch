diff --git a/plugins/automation-state/src/main/kotlin/app/aaps/plugins/automationstate/compose/AutomationStateScreen.kt b/plugins/automation-state/src/main/kotlin/app/aaps/plugins/automationstate/compose/AutomationStateScreen.kt
